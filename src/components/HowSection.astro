---
import WhatsAppIcon from './icons/WhatsApp.astro';
import TelegramIcon from './icons/Telegram.astro';

interface Props {
  title: string;
  waText: string;
  tgText: string;
}

const { title, waText, tgText } = Astro.props;
---

<section class="how max-w-[1120px] mx-auto px-5 py-[55px] max-md:py-[45px] border-t border-b border-base-300">
  <h2 
    id="how-title"
    class="text-center font-heading text-[clamp(27px,4vw,38px)] font-bold mb-[35px]"
  >
    {title}
  </h2>
  <div class="how-grid grid grid-cols-1 md:grid-cols-2 gap-[18px]">
    
    <!-- WhatsApp Card -->
    <article class="bg-gradient-to-br from-[#171b24] to-[#10131a] border border-base-300 rounded-[18px] p-6 max-md:p-5 flex flex-col gap-3.5">
      <div class="flex items-center gap-3.5">
        <div class="service wa w-[46px] h-[46px] flex-shrink-0 grid place-items-center bg-[#20bb68] text-white rounded-[13px]">
          <WhatsAppIcon class="w-6 h-6" />
        </div>
        <h3 class="font-heading text-[22px] font-bold text-white m-0">
          WhatsApp
        </h3>
      </div>
      <p class="text-secondary font-medium text-[16px] md:text-[18px] leading-[1.55] m-0">
        {waText}
      </p>
    </article>

    <!-- Telegram Card -->
    <article class="bg-gradient-to-br from-[#171b24] to-[#10131a] border border-base-300 rounded-[18px] p-6 max-md:p-5 flex flex-col gap-3.5">
      <div class="flex items-center gap-3.5">
        <div class="service tg w-[46px] h-[46px] flex-shrink-0 grid place-items-center bg-[#38a9e6] text-white rounded-[13px]">
          <TelegramIcon class="w-6 h-6" />
        </div>
        <h3 class="font-heading text-[22px] font-bold text-white m-0">
          Telegram
        </h3>
      </div>
      <p class="text-secondary font-medium text-[16px] md:text-[18px] leading-[1.55] m-0">
        {tgText}
      </p>
    </article>

  </div>
</section>
